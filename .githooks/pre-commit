#!/usr/bin/env bash
# Pre-commit guardrail for this repo. Four checks, in order:
#
#   1. secret scan (gitleaks) — a staged change must not carry a credential
#   2. skill structure check   — frontmatter, relative links, tracked-or-mirrored
#   3. skillspector scan       — prompt injection, exfiltration, supply chain
#   4. skill tree sync check   — the repo copy and the live copy agree
#
# Installed with `git config core.hooksPath .githooks`.
# CI runs the same policy on every push and PR:
#   .github/workflows/gitleaks.yml      (secret scan)
#   .github/workflows/skillspector.yml  (structure + skillspector)
# This hook is the fast local signal.

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

status=0

# --- 1. secret scan --------------------------------------------------------
if command -v gitleaks >/dev/null 2>&1; then
  GITLEAKS=(gitleaks)
elif command -v nix >/dev/null 2>&1; then
  GITLEAKS=(nix run nixpkgs#gitleaks --)
else
  echo "secret-scan: gitleaks unavailable (need gitleaks on PATH or nix) — skipping" >&2
  GITLEAKS=()
fi

if [ "${#GITLEAKS[@]}" -gt 0 ]; then
  echo "secret-scan: running gitleaks"
  if ! "${GITLEAKS[@]}" git --staged -c .gitleaks.toml --redact --no-banner; then
    echo "secret-scan: FAILED — staged content carries a secret" >&2
    status=1
  fi
fi

# --- 2 + 3. skill checks on the staged skills ------------------------------
mapfile -t staged_skills < <(
  git diff --cached --name-only --diff-filter=ACMR \
    | awk -F/ 'NF > 1 {print $1}' | sort -u \
    | while read -r d; do [ -f "$d/SKILL.md" ] && echo "$d"; done
)

if [ "${#staged_skills[@]}" -gt 0 ]; then
  echo "structure-check: ${staged_skills[*]}"
  if ! ./scripts/check-skills.sh "${staged_skills[@]}"; then
    status=1
  fi

  echo "skillspector: ${staged_skills[*]}"
  if ! ./scripts/scan-skills.sh "${staged_skills[@]}"; then
    status=1
  fi
else
  echo "structure-check: no skill directories in this commit — skipping"
fi

# --- 4. skill tree sync ----------------------------------------------------
# The skills an agent loads are the persona copies, not the repo copies. A
# commit that changes one without the other leaves the loaded skill stale.
echo "skill-sync: checking the repo copy against the live copy"
if ! ./scripts/check-skill-sync.sh; then
  status=1
fi

exit "$status"
